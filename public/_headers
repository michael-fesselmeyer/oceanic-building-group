# Security headers for every static file. Generated from src/lib/security-headers.ts, which
# also applies them to Worker responses; a unit test keeps the two identical. Why each one is
# set: docs/architecture.md#security-headers. The build adds a cache rule for /_astro/*.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
