{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/client",
      "url": ["http://localhost/404.html", "http://localhost/contact/thanks/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "skipAudits": ["is-crawlable"],
        "blockedUrlPatterns": ["*cloudflareinsights.com/cdn-cgi/rum*"]
      }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-reports/noindex"
    }
  }
}
