---
// The outer shell of every page: <head>, fonts, global styles, skip link,
// header and footer.
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import Seo from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { Crumb, JsonLd } from '../lib/structured-data';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';

interface Props {
  /** Page name for the browser tab. Leave out on the home page. */
  title?: string;
  /** One or two sentences for search results, 50 to 160 characters. */
  description: string;
  /** Share image address. Leave out to use the default brand card. */
  image?: string;
  /** What the share image shows. Pass it with `image`. */
  imageAlt?: string;
  /** Pixel size of the share image. Pass it with `image`. */
  imageSize?: { width: number; height: number };
  /** Keeps the page out of search engines even after launch. */
  noindex?: boolean;
  /** Leaves out the canonical link. Only for the 404 page, which has no address of its own. */
  noCanonical?: boolean;
  /** Breadcrumb trail from the home page to this page. Pass it on nested pages only. */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD nodes for this page (see src/lib/structured-data.ts). */
  structuredData?: JsonLd[];
  /**
   * The page opens with a full-bleed photograph. The header floats over it and turns solid
   * once the page scrolls past it. The first element inside <main> must be that photograph
   * section. Leave out on pages without one: they keep the solid header.
   */
  overHero?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  imageSize,
  noindex,
  noCanonical,
  breadcrumbs,
  structuredData,
  overHero = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      imageSize={imageSize}
      noindex={noindex}
      noCanonical={noCanonical}
      breadcrumbs={breadcrumbs}
      structuredData={structuredData}
    />
    {/* Icons and manifest are generated by `npm run brand`. The theme color is
         --color-navy-900 from tokens.css; a unit test keeps the two in step. */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#012753" />
    <Font cssVariable="--font-newsreader" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-hanken" preload />
  </head>
  <body class:list={{ 'over-hero': overHero }}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader overHero={overHero} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <Analytics />
  </body>
</html>

<style>
  /* Keeps the footer at the bottom on short pages. */
  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex-grow: 1;
  }

  main:focus {
    outline: none;
  }

  /*
   * Hero pages: the first element in <main> gets a view timeline, and the body shares it with
   * the header (a sibling of <main>), which animates against it. The inset starts the timeline
   * at the header's bottom edge, so it ends when the photograph has scrolled out from under
   * the header. Browsers without these features ignore the block.
   */
  @supports (view-timeline: --hero) and (timeline-scope: --hero) {
    body.over-hero {
      timeline-scope: --hero;
    }

    body.over-hero main > :global(:first-child) {
      view-timeline: --hero block;
      view-timeline-inset: var(--header-height) 0;
    }
  }
</style>
