---
// "What we build" on the home page: the service lines as a numbered, ruled
// index beside a short introduction, each title linking to its page.
//
//   services  The service lines in order. With none, nothing is rendered.
//
// The introduction stays in view while the list scrolls past it on wide
// screens; from 800px down the two stack.
import SectionHeading from '../SectionHeading.astro';
import TextLink from '../TextLink.astro';
import { listNumber, type HomeService } from '../../lib/home';
import { SERVICES_PATH } from '../../lib/services';
import { site } from '../../lib/site';

interface Props {
  services: HomeService[];
}

const { services } = Astro.props;
---

{services.length > 0 && (
  <section class="container home-services" aria-labelledby="services-heading">
    <div class="intro">
      <SectionHeading id="services-heading" label="Services">
        What we build
      </SectionHeading>
      <p class="intro-text">
        {site.name} builds custom homes, renovations and commercial projects in {site.serviceArea}.
      </p>
      <p>
        <TextLink href={SERVICES_PATH}>All services</TextLink>
      </p>
    </div>
    <ol role="list" class="list">
      {services.map((service, index) => (
        <li class="row">
          <p class="number" aria-hidden="true">
            {listNumber(index)}
          </p>
          <div>
            <h3>
              <a href={service.href}>{service.title}</a>
            </h3>
            <p class="summary">{service.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .home-services {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-7) var(--space-6);
    align-items: start;
    margin-top: var(--section-gap);
  }

  .intro {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
    grid-column: 1 / 6;
    display: grid;
    gap: var(--space-5);
  }

  .intro-text {
    color: var(--color-text-muted);
  }

  .list {
    grid-column: 7 / -1;
    border-top: 1px solid var(--color-heading);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: var(--space-8) minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .number {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    color: var(--color-link);
  }

  h3 {
    font-size: var(--text-2xl);
  }

  /* The whole row is clickable through the title link. */
  h3 a {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--duration-fast) var(--ease-out);
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  h3 a:focus-visible {
    outline: none;
  }

  h3 a:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: calc(-1 * var(--space-1));
  }

  .row:hover h3 a,
  h3 a:focus-visible {
    text-decoration-color: currentColor;
  }

  .summary {
    max-width: var(--width-prose);
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  @media (max-width: 800px) {
    .home-services {
      grid-template-columns: minmax(0, 1fr);
    }

    .intro {
      position: static;
      grid-column: auto;
      max-width: var(--width-prose);
    }

    .list {
      grid-column: auto;
    }
  }

  @media (max-width: 520px) {
    .row {
      grid-template-columns: var(--space-7) minmax(0, 1fr);
      gap: var(--space-3);
      padding-block: var(--space-5);
    }
  }
</style>
