---
// The interior design partner on the home page: her name set large beside
// a short introduction and a link to /interior-design/.
//
//   partner  From `site.designPartner`. While `null`, nothing is rendered.
//   summary  The summary from her content file. Left out when empty.
//   basedIn  Where her studio is. Left out when empty.
//
// No photograph: the section reads as a short editorial note between the
// process band and the closing contact band.
import SectionHeading from '../SectionHeading.astro';
import TextLink from '../TextLink.astro';
import { DESIGN_PARTNER_PATH } from '../../lib/design-partner';
import { site, type DesignPartner } from '../../lib/site';

interface Props {
  partner: DesignPartner | null;
  summary?: string | null;
  basedIn?: string | null;
}

const { partner, summary, basedIn } = Astro.props;
const lede = summary?.trim();
const place = basedIn?.trim();
---

{partner && (
  <section class="container home-partner" aria-labelledby="partner-heading">
    <div class="name">
      <SectionHeading id="partner-heading" label="Interior design partner">
        {partner.name}
      </SectionHeading>
      {place && <p class="place">Based in {place}</p>}
    </div>
    <div class="text">
      <p class="intro">
        {site.name} works with interior designer {partner.name} on selected homes.
      </p>
      {lede && <p class="summary">{lede}</p>}
      <p>
        <TextLink href={DESIGN_PARTNER_PATH}>Meet {partner.name}</TextLink>
      </p>
    </div>
  </section>
)}

<style>
  .home-partner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-6);
    align-items: start;
    margin-top: var(--section-gap);
  }

  .name {
    grid-column: 1 / 6;
  }

  .place {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  /* A rule down the left of the text, like a sidebar note in print. */
  .text {
    grid-column: 7 / -1;
    display: grid;
    gap: var(--space-5);
    padding-left: var(--space-6);
    border-left: 1px solid var(--color-border);
  }

  .intro {
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .summary {
    max-width: var(--width-prose);
    color: var(--color-text-muted);
  }

  @media (max-width: 800px) {
    .home-partner {
      grid-template-columns: minmax(0, 1fr);
    }

    .name,
    .text {
      grid-column: auto;
    }
  }

  @media (max-width: 520px) {
    .text {
      padding-left: var(--space-5);
    }
  }
</style>
