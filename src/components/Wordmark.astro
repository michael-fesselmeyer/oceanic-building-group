---
// The company wordmark, simplified from the full logo so it reads at header
// size. It is drawn in the current text color: navy on white by default,
// white over photography when a parent sets `color` to white.
//
// The artwork is generated by `npm run brand` (scripts/build-brand.mjs);
// edit the script, not the SVG.
import WordmarkArt from '../assets/brand/wordmark.svg';
import { site } from '../lib/site';
---

<span class="wordmark">
  <WordmarkArt aria-hidden="true" focusable="false" />
  <span class="visually-hidden">{site.name}</span>
</span>

<style>
  .wordmark {
    display: block;
    height: var(--wordmark-height);
    line-height: 0;
  }

  .wordmark :global(svg) {
    width: auto;
    height: 100%;
  }
</style>
