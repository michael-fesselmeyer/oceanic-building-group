---
// An underlined link for use inside or after a sentence ("Read the full
// story", "See every renovation"). Use Button for the main action of a
// section instead.
//
//   href     Where it goes.
//   inverse  Set on dark backgrounds.
//
// The link text goes in the default slot and should make sense on its own,
// never "click here". Surrounding whitespace in the slot is trimmed, so
// the underline never runs past the words.
interface Props {
  href: string;
  inverse?: boolean;
}

const { href, inverse = false } = Astro.props;
const text = (await Astro.slots.render('default')).trim();
---

<a class:list={['text-link', { inverse }]} href={href} set:html={text} />

<style>
  .text-link {
    color: var(--color-heading);
    text-decoration-line: underline;
    text-decoration-color: var(--color-link);
    text-decoration-thickness: 1px;
    text-underline-offset: var(--underline-offset-loose);
    transition:
      color var(--duration-fast) var(--ease-out),
      text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .text-link:hover {
    color: var(--color-link);
    text-decoration-thickness: 2px;
  }

  .inverse {
    color: var(--color-text-on-strong);
    text-decoration-color: var(--color-ocean-300);
  }

  .inverse:hover {
    color: var(--color-ocean-300);
  }
</style>
