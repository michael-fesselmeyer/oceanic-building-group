---
// One before-and-after pair on a project page. With JavaScript the two
// photographs are stacked: the "before" is revealed from the left up to a
// handle, and a range input moves it, so the comparison works by pointer,
// touch and keyboard (arrows, Home and End). Without JavaScript the pair is
// shown side by side under "Before" and "After" labels. Both photographs are
// cropped to the same 3:2 shape so they line up.
//
//   before, after        Images from the project's `beforeAfter` list.
//   beforeAlt, afterAlt  What each photograph shows.
//   caption              Optional line under the pair.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  before: ImageMetadata;
  beforeAlt: string;
  after: ImageMetadata;
  afterAlt: string;
  caption?: string;
}

const { before, beforeAlt, after, afterAlt, caption } = Astro.props;
const widths = [640, 960, 1280, 1920];
const sizes = '(max-width: 1216px) 100vw, 1216px';
const formats = ['avif', 'webp'] as const;
---

<figure class="compare" data-compare data-reveal>
  <div class="frame">
    <div class="side side-before">
      <Picture
        src={before}
        alt={beforeAlt}
        widths={widths}
        sizes={sizes}
        formats={[...formats]}
        loading="lazy"
        class="compare-img"
      />
      <span class="tag tag-before">Before</span>
    </div>
    <div class="side side-after">
      <Picture
        src={after}
        alt={afterAlt}
        widths={widths}
        sizes={sizes}
        formats={[...formats]}
        loading="lazy"
        class="compare-img"
      />
      <span class="tag tag-after">After</span>
    </div>
    <span class="handle" aria-hidden="true"></span>
    <input
      class="range"
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      aria-label="Show more of the before photograph"
      hidden
    />
  </div>
  {caption?.trim() && <figcaption>{caption.trim()}</figcaption>}
</figure>

<script>
  // Turns each side-by-side pair into a stacked comparison. The range input
  // ships hidden, so a page without this script never shows a control that
  // does nothing.
  for (const figure of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const range = figure.querySelector<HTMLInputElement>('.range');
    if (!range) continue;
    const update = () => {
      figure.style.setProperty('--split', `${range.value}%`);
      range.setAttribute('aria-valuetext', `${range.value}% before`);
    };
    range.addEventListener('input', update);
    range.hidden = false;
    update();
    figure.classList.add('is-ready');
  }
</script>

<style>
  .compare {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .frame {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .side {
    position: relative;
  }

  .compare-img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--color-surface);
  }

  .tag {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: var(--space-1) var(--space-2);
    background: var(--color-surface-strong);
    color: var(--color-text-on-strong);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
  }

  .handle {
    display: none;
  }

  /* Stacked: one frame, the "before" on top, cut off at the split. */
  .is-ready .frame {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }

  .is-ready .side-before {
    position: absolute;
    inset: 0;
    z-index: 1;
    clip-path: inset(0 calc(100% - var(--split, 50%)) 0 0);
  }

  .is-ready .tag-after {
    right: var(--space-3);
    left: auto;
  }

  .is-ready .handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split, 50%);
    z-index: 2;
    display: block;
    width: 2px;
    background: var(--color-white);
    transform: translateX(-50%);
    pointer-events: none;
  }

  /* The knob in the middle of the line shows where to drag. */
  .is-ready .handle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--space-6);
    height: var(--space-6);
    border: 2px solid var(--color-white);
    border-radius: 50%;
    background: var(--color-surface-strong);
    transform: translate(-50%, -50%);
  }

  /* The range covers the photograph, so a drag anywhere moves the split. */
  .range {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .range[hidden] {
    display: none;
  }

  .frame:has(.range:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: var(--focus-offset-wide);
  }

  figcaption {
    max-width: var(--width-prose);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  @media (max-width: 520px) {
    .frame {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
