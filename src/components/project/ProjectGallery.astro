---
// A project's photographs, stacked one under another at the full width of
// the content column, on desktop and phone alike. Each photograph keeps its
// own shape; a portrait one is centered and narrowed so it fits on the
// screen whole.
//
//   photos  The project's `gallery` entries, in display order. An empty
//           list renders nothing at all.
//   label   Accessible name for the list, for example "Photographs of
//           River House".
//
// Lightbox. Every photograph is a link to a large version (2400px wide at
// most), so without JavaScript it opens as an ordinary image. A small script
// at the end of this file upgrades the links: a click opens the large version
// in a <dialog> placed right after the list, with previous, next and close
// buttons, the arrow keys, Escape and a swipe. The large image is only given
// its address when the dialog opens and loses it when it closes, so nothing
// large downloads until a visitor asks. The alt text comes from the thumbnail
// and the caption from the item's <figcaption>, when it has one; focus
// returns to the photograph that opened the dialog.
//
// Hooks: the list carries `data-gallery` and every item carries
// `data-gallery-item` with its zero-based position in `data-gallery-index`.
// Each item also has an id ("photo-1", "photo-2"...) so a photograph can be
// linked to directly.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Photo from '../Photo.astro';
import { aspectRatio } from '../../lib/project-page';

interface Props {
  photos: readonly { src: ImageMetadata; alt: string }[];
  label?: string;
}

const { photos, label } = Astro.props;

/** Wide photographs fill the column; portrait ones are shown about half as wide on desktop. */
const WIDE_SIZES = '(min-width: 1320px) 1216px, 92vw';
const PORTRAIT_SIZES = '(max-width: 800px) 92vw, 50vw';
/** The widest large version; a smaller master is not enlarged. */
const LARGE_WIDTH = 2400;

const large = await Promise.all(
  photos.map((photo) =>
    getImage({ src: photo.src, width: Math.min(LARGE_WIDTH, photo.src.width), format: 'webp' }),
  ),
);
---

{photos.length > 0 && (
  <>
    <ul role="list" class="gallery" aria-label={label} data-gallery>
      {photos.map((photo, index) => {
        const ratio = aspectRatio(photo.src);
        return (
          <li
            class:list={['gallery-item', { portrait: ratio < 1 }]}
            id={`photo-${index + 1}`}
            style={`--item-ratio: ${ratio}`}
            data-gallery-item
            data-gallery-index={index}
          >
            <a class="gallery-link" href={large[index]!.src} data-gallery-link>
              <Photo
                src={photo.src}
                alt={photo.alt}
                widths={[640, 960, 1280, 1920, 2400]}
                sizes={ratio < 1 ? PORTRAIT_SIZES : WIDE_SIZES}
              />
            </a>
          </li>
        );
      })}
    </ul>
    <dialog class="lightbox" aria-label={label ?? 'Photographs'} data-lightbox>
      <div class="stage" data-lightbox-stage>
        <img class="large" alt="" draggable="false" />
      </div>
      <div class="bar">
        <p class="caption" data-lightbox-caption hidden></p>
        <p class="count" aria-live="polite" data-lightbox-count></p>
        <div class="buttons">
          <button type="button" class="control" aria-label="Previous photograph" data-lightbox-prev>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" />
            </svg>
          </button>
          <button type="button" class="control" aria-label="Next photograph" data-lightbox-next>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
          <button type="button" class="control" aria-label="Close" data-lightbox-close>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>
      </div>
    </dialog>
  </>
)}

<script>
  // Opens a gallery's photographs in its <dialog>. Without this script the
  // links open the large image instead, so nothing here is required.
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.nextElementSibling;
    if (!(dialog instanceof HTMLDialogElement)) return;
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-gallery-link]')];
    const part = (name: string) => dialog.querySelector<HTMLElement>(`[data-lightbox-${name}]`)!;
    const image = dialog.querySelector('img')!;
    const [caption, count, stage] = [part('caption'), part('count'), part('stage')];
    let index = 0;
    let opener: HTMLElement | undefined;

    const show = (next: number) => {
      index = (next + links.length) % links.length;
      const link = links[index]!;
      const text = link.closest('[data-gallery-item]')?.querySelector('figcaption')?.textContent;
      image.alt = link.querySelector('img')?.alt ?? '';
      image.src = link.href;
      caption.textContent = text?.trim() ?? '';
      caption.hidden = !caption.textContent;
      count.textContent = `Photo ${index + 1} of ${links.length}`;
    };

    links.forEach((link, i) => {
      link.setAttribute('aria-haspopup', 'dialog');
      link.addEventListener('click', (event) => {
        const plain = !event.button && !(event.metaKey || event.ctrlKey || event.shiftKey);
        if (!plain || event.defaultPrevented) return;
        event.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
      });
    });

    if (links.length < 2) {
      part('prev').hidden = part('next').hidden = true;
    }
    part('prev').addEventListener('click', () => show(index - 1));
    part('next').addEventListener('click', () => show(index + 1));
    part('close').addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (event) => {
      if (links.length < 2 || (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')) return;
      show(index + (event.key === 'ArrowRight' ? 1 : -1));
    });

    // A horizontal swipe on the photograph moves to the next or previous one.
    let startX = 0;
    stage.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
      stage.setPointerCapture(event.pointerId);
    });
    stage.addEventListener('pointerup', (event) => {
      const moved = event.clientX - startX;
      if (links.length > 1 && Math.abs(moved) > 50) show(index + (moved < 0 ? 1 : -1));
    });

    // Escape and the close button both end here: free the large image and hand focus back.
    dialog.addEventListener('close', () => {
      image.removeAttribute('src');
      opener?.focus();
    });
  });
</script>

<style>
  .gallery {
    display: grid;
    gap: var(--space-7);
  }

  .gallery-item {
    scroll-margin-top: calc(var(--header-height) + var(--space-5));
  }

  .gallery-link {
    display: block;
    cursor: zoom-in;
  }

  /* The overlay: the whole screen, a photograph above a bar of caption and buttons. */
  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-navy-950);
    color: var(--color-text-on-strong);
  }

  .lightbox[open] {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: var(--space-5) var(--page-gutter) 0;
    /* A sideways swipe is ours; a vertical one still scrolls nothing, the overlay has no scroll. */
    touch-action: pan-y;
    user-select: none;
  }

  /* Shown whole, as large as the space allows, never cropped or stretched. */
  .large {
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-4) var(--page-gutter);
  }

  .caption {
    flex: 1 1 100%;
    max-width: var(--width-prose);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .count {
    flex: 1 1 auto;
    color: var(--color-ocean-300);
    font-size: var(--text-sm);
  }

  .buttons {
    display: flex;
    gap: var(--space-2);
  }

  /* 48px square: comfortable for a thumb. */
  .control {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid var(--color-ocean-300);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-on-strong);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .control:hover {
    background: var(--color-navy-700);
  }

  .control:focus-visible {
    outline-color: var(--color-white);
  }

  .control svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The page behind an open overlay does not scroll. */
  :global(body:has(dialog.lightbox[open])) {
    overflow: hidden;
  }

  /* A portrait photograph is centered and narrowed so it is never taller than the screen. */
  .portrait {
    justify-self: center;
    width: min(100%, var(--photo-max-height) * var(--item-ratio));
  }

  @media (max-width: 800px) {
    .gallery {
      gap: var(--space-5);
    }
  }

  @media (max-width: 520px) {
    .gallery {
      gap: var(--space-4);
    }
  }
</style>
