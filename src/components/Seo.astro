---
// Everything search engines and link previews read from <head>.
import { canonicalUrl, pageTitle } from '../lib/seo';
import { launched, site } from '../lib/site';

interface Props {
  /** Page name. Leave out on the home page. */
  title?: string;
  description: string;
  /** Absolute or root-relative address of the share image. */
  image?: string;
  /** Keeps this page out of search engines even after launch. */
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
const fullTitle = pageTitle(site.name, title, site.tagline);
const canonical = canonicalUrl(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const shareImage = image ? new URL(image, Astro.site ?? Astro.url.origin).href : undefined;
const hidden = noindex || !launched;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{hidden && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{shareImage && <meta property="og:image" content={shareImage} />}
<meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
