---
// Everything search engines and link previews read from <head>.
import { canonicalUrl, DEFAULT_SHARE_IMAGE, pageTitle, shareImageUrl } from '../lib/seo';
import { launched, site } from '../lib/site';
import { pageGraph, serializeJsonLd, type Crumb, type JsonLd } from '../lib/structured-data';

interface Props {
  /** Page name. Leave out on the home page. */
  title?: string;
  description: string;
  /** Absolute or root-relative address of the share image. Defaults to the brand card. */
  image?: string;
  /** What the share image shows. Pass it with `image`. */
  imageAlt?: string;
  /** Pixel size of the share image. Pass it with `image` so previews can reserve space. */
  imageSize?: { width: number; height: number };
  /** Keeps this page out of search engines even after launch. */
  noindex?: boolean;
  /** Trail from the home page down to this page, for nested pages. */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD nodes for this page, such as a project description. */
  structuredData?: JsonLd[];
}

const {
  title,
  description,
  image,
  imageAlt,
  imageSize,
  noindex = false,
  breadcrumbs,
  structuredData,
} = Astro.props;
const fullTitle = pageTitle(site.name, title, site.tagline);
const canonical = canonicalUrl(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const shareImage = shareImageUrl(image, Astro.site ?? Astro.url.origin);
// The default card's size and description are known here; any other image states its own.
const isDefaultImage = !image?.trim();
const defaultImageAlt = `${site.name} wordmark in white on navy, with the line “${site.tagline}”`;
const shareSize = isDefaultImage ? DEFAULT_SHARE_IMAGE : imageSize;
const shareAlt = isDefaultImage ? defaultImageAlt : imageAlt?.trim();
const hidden = noindex || !launched;
const graph = pageGraph({
  facts: site,
  siteUrl: Astro.site ?? Astro.url.origin,
  pathname: Astro.url.pathname,
  breadcrumbs,
  nodes: structuredData,
});
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{/* A page kept out of search has no canonical address: the 404 page has none to give. */}
{!noindex && <link rel="canonical" href={canonical} />}
{hidden && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={shareImage} />
{shareSize && <meta property="og:image:width" content={String(shareSize.width)} />}
{shareSize && <meta property="og:image:height" content={String(shareSize.height)} />}
{shareAlt && <meta property="og:image:alt" content={shareAlt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={shareImage} />

<script type="application/ld+json" set:html={serializeJsonLd(graph)} />
