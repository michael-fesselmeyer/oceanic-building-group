---
// The contact page body: the project intake form beside the office details.
// Used by /contact/ and by the intake endpoint (src/pages/api/intake.astro),
// which shows the form again, filled in with what the visitor typed, when an
// answer needs fixing or the enquiry could not be sent.
//
// The form's fields, limits and messages come from src/lib/intake.ts, which
// the endpoint also uses, so the browser and the server check the same rules.
// Without JavaScript the browser's own validation stops an incomplete form;
// the script at the bottom replaces it with messages written under each
// field, a summary at the top and focus on the first answer to fix.
//
// Optional follow-up questions sit under the project type. CSS shows the
// ones for the chosen type with :has(), with no script; a browser without
// :has() shows them all, and the server keeps only the answers that belong
// to the type that was sent.
import Button from '../Button.astro';
import TextLink from '../TextLink.astro';
import { getTowns } from '../../lib/content';
import {
  HONEYPOT_FIELD,
  INTAKE_ENDPOINT,
  PHONE_PATTERN,
  followUps,
  limits,
  messages,
  notices,
  projectTypes,
  townChoices,
  type FormField,
  type IntakeField,
  type Notice,
} from '../../lib/intake';
import { formatPhone } from '../../lib/seo';
import { site } from '../../lib/site';
import { TURNSTILE_SCRIPT, formSiteKey } from '../../lib/turnstile';

interface Props {
  /** What the visitor typed, to fill the form in again. */
  values?: Partial<Record<FormField, string>>;
  /** One message per answer that needs fixing, from the server's check. */
  errors?: Partial<Record<IntakeField, string>>;
  /** Why the form came back when the answers themselves were fine. */
  notice?: Notice;
}

const { values = {}, errors = {}, notice } = Astro.props;

const towns = townChoices(await getTowns());
/** `data-for` on each follow-up, matched by the reveal rules in the styles below. */
const appliesTo = (types: 'every' | readonly string[]) =>
  types === 'every' ? 'every' : types.join(' ');

const { address } = site;
const oneLineAddress = `${address.street}, ${address.city}, ${address.region} ${address.postalCode}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${site.name}, ${oneLineAddress}`,
)}`;

// A loose email shape for the browser: text, an at sign, then a domain with a
// dot in it. The schema runs the stricter check on the server.
const EMAIL_PATTERN = '[^@\\s]+@[^@\\s]+\\.[^@\\s]+';

// Cloudflare Turnstile. Development and preview builds use Cloudflare's
// always-pass test key; a launched build without a key renders no widget.
// The page that renders this component allows Turnstile in its content
// security policy (allowTurnstile in src/lib/security-headers.ts).
const siteKey = formSiteKey;

// The answers the server sent back, in form order, for the summary. Each
// links to the control it is about (the first option for the project type).
const controlIds: Record<IntakeField, string> = {
  name: 'name',
  email: 'email',
  phone: 'phone',
  projectType: `projectType-${projectTypes[0].value}`,
  message: 'message',
};
const problems = (Object.keys(controlIds) as IntakeField[])
  .filter((field) => errors[field])
  .map((field) => ({ id: controlIds[field], message: errors[field]! }));
const invalid = (field: IntakeField) => (errors[field] ? 'true' : undefined);
const summaryTitle =
  problems.length === 1
    ? 'Please fix one answer before sending'
    : `Please fix ${problems.length} answers before sending`;
---

<div class="container contact">
  <header class="intro">
    <p class="label kicker">Contact</p>
    <h1>Start a project</h1>
    <p class="lede">
      Tell us what you have in mind, whether it is a new home, a renovation or a commercial
      building. A few lines are enough to begin the conversation.
    </p>
  </header>

  <form
    class="intake"
    action={INTAKE_ENDPOINT}
    method="post"
    aria-label="Project enquiry"
    data-intake
    data-attempted={problems.length > 0 ? '' : undefined}
  >
    {/* Why the form came back. Focused on arrival so it is read first. */}
    {notice && (
      <p class="notice" tabindex="-1" autofocus data-notice>
        {notices[notice]}
      </p>
    )}

    <p class="note">All fields are required unless marked optional.</p>

    {/* Rendered by the server after a failed check, or by the script. */}
    <div
      class="summary"
      aria-labelledby="summary-heading"
      tabindex="-1"
      autofocus={problems.length > 0 && !notice}
      data-error-summary
      hidden={problems.length === 0}
    >
      <h2 id="summary-heading" class="summary-heading">
        {problems.length > 0 ? summaryTitle : 'Please check your answers'}
      </h2>
      <ul role="list">
        {problems.map((problem) => (
          <li>
            <a href={`#${problem.id}`}>{problem.message}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="fields">
      <div class="field wide" data-field>
        <label for="name">Name</label>
        <input
          class="control"
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          required
          maxlength={limits.name.max}
          value={values.name}
          aria-invalid={invalid('name')}
          aria-describedby="name-error"
          data-required={messages.nameRequired}
          data-too-long={messages.nameTooLong}
        />
        <p class="error" id="name-error" data-error hidden={!errors.name}>
          {errors.name}
        </p>
      </div>

      <div class="field" data-field>
        <label for="email">Email</label>
        <input
          class="control"
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          maxlength={limits.email.max}
          pattern={EMAIL_PATTERN}
          value={values.email}
          aria-invalid={invalid('email')}
          aria-describedby="email-error"
          data-required={messages.emailRequired}
          data-invalid={messages.emailInvalid}
          data-too-long={messages.emailTooLong}
        />
        <p class="error" id="email-error" data-error hidden={!errors.email}>
          {errors.email}
        </p>
      </div>

      <div class="field" data-field>
        <label for="phone">
          Phone <span class="optional">(optional)</span>
        </label>
        <input
          class="control"
          id="phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          maxlength={limits.phone.max}
          pattern={PHONE_PATTERN}
          value={values.phone}
          aria-invalid={invalid('phone')}
          aria-describedby="phone-error"
          data-invalid={messages.phoneInvalid}
          data-too-long={messages.phoneInvalid}
        />
        <p class="error" id="phone-error" data-error hidden={!errors.phone}>
          {errors.phone}
        </p>
      </div>

      <fieldset class="field wide choices" data-field>
        <legend>Type of project</legend>
        <div class="options">
          {projectTypes.map((type) => (
            <label class="option">
              <input
                id={`projectType-${type.value}`}
                type="radio"
                name="projectType"
                value={type.value}
                required
                checked={values.projectType === type.value}
                aria-invalid={invalid('projectType')}
                aria-describedby="projectType-error"
                data-required={messages.projectTypeRequired}
              />
              <span>{type.label}</span>
            </label>
          ))}
        </div>
        <p class="error" id="projectType-error" data-error hidden={!errors.projectType}>
          {errors.projectType}
        </p>
      </fieldset>

      {/*
       * Follow-up questions, all optional. Shown for the chosen project type
       * by the reveal rules at the end of the styles; each one's data-for
       * lists the types it belongs to. They have no data-field, so the
       * script never marks them: no answer here can be wrong.
       */}
      <div class="follow-ups wide" data-follow-ups>
        {followUps.map((question) => {
          const id = `followUp-${question.field}`;
          if (question.kind === 'choice') {
            return (
              <fieldset class="field wide choices follow-up" data-for={appliesTo(question.types)}>
                <legend>
                  {question.question} <span class="optional">(optional)</span>
                </legend>
                <div class="options">
                  {question.choices.map((choice) => (
                    <label class="option">
                      <input
                        id={`${id}-${choice.value}`}
                        type="radio"
                        name={question.field}
                        value={choice.value}
                        checked={values[question.field] === choice.value}
                      />
                      <span>{choice.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            );
          }
          if (question.kind === 'town') {
            return (
              <div class="field follow-up" data-for={appliesTo(question.types)}>
                <label for={id}>
                  {question.question} <span class="optional">(optional)</span>
                </label>
                <select class="control" id={id} name={question.field}>
                  <option value="">Choose a town</option>
                  {towns.map((town) => (
                    <option value={town.value} selected={values[question.field] === town.value}>
                      {town.label}
                    </option>
                  ))}
                </select>
              </div>
            );
          }
          return (
            <div class="field follow-up" data-for={appliesTo(question.types)}>
              <label for={id}>
                {question.question} <span class="optional">(optional)</span>
              </label>
              <p class="hint" id={`${id}-hint`}>
                {question.hint}
              </p>
              <input
                class="control"
                id={id}
                name={question.field}
                type="text"
                maxlength={question.maxLength}
                value={values[question.field]}
                aria-describedby={`${id}-hint`}
              />
            </div>
          );
        })}
      </div>

      <div class="field wide" data-field>
        <label for="message">About your project</label>
        <p class="hint" id="message-hint">
          What you have in mind and anything you already know.
        </p>
        <textarea
          class="control"
          id="message"
          name="message"
          rows="7"
          required
          minlength={limits.message.min}
          maxlength={limits.message.max}
          aria-invalid={invalid('message')}
          aria-describedby="message-hint message-error"
          data-required={messages.messageRequired}
          data-too-short={messages.messageTooShort}
          data-too-long={messages.messageTooLong}
        >{values.message}</textarea>
        <p class="error" id="message-error" data-error hidden={!errors.message}>
          {errors.message}
        </p>
      </div>
    </div>

    {/*
     * Spam trap. Moved off-screen rather than set to display: none, because
     * some programs skip fields that are not displayed. It is hidden from
     * assistive technology and taken out of the tab order, so no visitor
     * ever reaches it; programs that fill in every field do, and the
     * endpoint drops their submissions.
     */}
    <div class="visually-hidden" aria-hidden="true">
      <label for={HONEYPOT_FIELD}>Website</label>
      <input
        id={HONEYPOT_FIELD}
        name={HONEYPOT_FIELD}
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    {/*
     * Spam check. Cloudflare's script fills this in and adds a hidden
     * cf-turnstile-response field that the endpoint verifies. Without
     * JavaScript it stays empty and the form still posts; see
     * docs/architecture.md for how the endpoint treats that.
     */}
    {siteKey && (
      <div class="spam-check">
        <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" data-size="flexible" />
      </div>
    )}

    <div class="actions">
      <Button type="submit">Send enquiry</Button>
      <p class="privacy">
        We use your details only to reply to you. See our <a href="/privacy/">privacy policy</a>.
      </p>
    </div>
  </form>

  <aside class="office" aria-labelledby="office-heading">
    <h2 id="office-heading" class="office-heading">
      The office
    </h2>
    <address>
      <p>{site.legalName}</p>
      <p>{address.street}</p>
      <p>
        {address.city}, {address.region} {address.postalCode}
      </p>
    </address>
    <p class="directions">
      <TextLink href={directionsUrl}>Get directions</TextLink>
    </p>
    {(site.phone || site.licenseNumber) && (
      <dl class="facts">
        {site.phone && (
          <div>
            <dt class="label">Phone</dt>
            <dd>
              <a href={`tel:+1${site.phone}`}>{formatPhone(site.phone)}</a>
            </dd>
          </div>
        )}
        {site.licenseNumber && (
          <div>
            <dt class="label">License</dt>
            <dd>{site.licenseNumber}</dd>
          </div>
        )}
      </dl>
    )}
    <p class="area">Building across {site.serviceArea}.</p>
  </aside>
</div>

{siteKey && <script is:inline src={TURNSTILE_SCRIPT} async defer></script>}

<script>
  // Inline validation. Runs only where JavaScript is available; without it
  // the browser's built-in checks still stop an incomplete form. Messages
  // are read from data attributes rendered from src/lib/intake.ts.
  type Control = HTMLInputElement | HTMLTextAreaElement;
  type Problem = { message: string; target: Control };

  const form = document.querySelector<HTMLFormElement>('form[data-intake]');
  if (form) enhance(form);

  function enhance(form: HTMLFormElement) {
    const fields = [...form.querySelectorAll<HTMLElement>('[data-field]')];
    const summary = form.querySelector<HTMLElement>('[data-error-summary]');
    const summaryHeading = summary?.querySelector('h2');
    const summaryList = summary?.querySelector('ul');
    if (!summary || !summaryHeading || !summaryList) return;

    // A form the server sent back already shows its messages, so corrections
    // update them from the first keystroke.
    let attempted = form.dataset.attempted !== undefined;
    let sending = false;
    form.noValidate = true;

    // A browser may skip autofocus; start the visitor at what the server sent back.
    form.querySelector<HTMLElement>('[autofocus]')?.focus();

    const controlsOf = (field: HTMLElement) => [
      ...field.querySelectorAll<Control>('input, textarea'),
    ];

    // Mirrors the schema: answers are trimmed before their length is judged.
    function messageFor(control: Control): string {
      const { validity, dataset } = control;
      const length = control.value.trim().length;
      if (validity.valueMissing || (control.required && length === 0)) {
        return dataset.required ?? control.validationMessage;
      }
      if (validity.typeMismatch || validity.patternMismatch) {
        return dataset.invalid ?? control.validationMessage;
      }
      if (control.minLength > 0 && length < control.minLength) {
        return dataset.tooShort ?? control.validationMessage;
      }
      if (validity.tooLong) return dataset.tooLong ?? control.validationMessage;
      return validity.valid ? '' : control.validationMessage;
    }

    function check(field: HTMLElement): Problem | null {
      const controls = controlsOf(field);
      const message = controls.map(messageFor).find(Boolean) ?? '';
      const error = field.querySelector<HTMLElement>('[data-error]');
      if (error) {
        error.textContent = message;
        error.hidden = !message;
      }
      for (const control of controls) {
        if (message) control.setAttribute('aria-invalid', 'true');
        else control.removeAttribute('aria-invalid');
      }
      return message && controls[0] ? { message, target: controls[0] } : null;
    }

    function showSummary(problems: Problem[]) {
      summaryList!.replaceChildren(
        ...problems.map(({ message, target }) => {
          const link = document.createElement('a');
          link.href = `#${target.id}`;
          link.textContent = message;
          link.addEventListener('click', (event) => {
            event.preventDefault();
            target.focus();
          });
          const item = document.createElement('li');
          item.append(link);
          return item;
        }),
      );
      summaryHeading!.textContent =
        problems.length === 1
          ? 'Please fix one answer before sending'
          : `Please fix ${problems.length} answers before sending`;
      summary!.hidden = problems.length === 0;
    }

    const checkAll = () => fields.map(check).filter((problem) => problem !== null);

    form.addEventListener('submit', (event) => {
      attempted = true;
      const problems = checkAll();
      showSummary(problems);
      if (problems.length > 0) {
        event.preventDefault();
        problems[0].target.focus();
        return;
      }
      // One enquiry per click: a second press while the first is on its way
      // would only post the same answers again.
      if (sending) event.preventDefault();
      sending = true;
    });

    // Coming back to the page with the Back button allows sending again.
    window.addEventListener('pageshow', () => {
      sending = false;
    });

    // After the first attempt, messages update as each answer is corrected.
    const recheck = (event: Event) => {
      if (!attempted || !(event.target instanceof Element)) return;
      const field = event.target.closest<HTMLElement>('[data-field]');
      if (!field) return;
      check(field);
      showSummary(checkAll());
    };
    form.addEventListener('input', recheck);
    form.addEventListener('change', recheck);
  }
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas:
      'intro form'
      'office form';
    grid-template-rows: auto 1fr;
    column-gap: var(--space-9);
    row-gap: var(--space-7);
    padding-top: var(--space-8);
  }

  /* Intro */

  .intro {
    grid-area: intro;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    color: var(--color-link);
  }

  .kicker::before {
    content: '';
    width: var(--space-6);
    border-top: 1px solid currentColor;
  }

  h1 {
    margin-top: var(--space-4);
    font-size: var(--text-3xl);
  }

  .lede {
    margin-top: var(--space-5);
    max-width: var(--width-lede);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  /* Office */

  .office {
    grid-area: office;
    align-self: start;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .office-heading {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  address {
    margin-top: var(--space-4);
    font-style: normal;
  }

  .directions,
  .area {
    margin-top: var(--space-4);
  }

  .facts {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
  }

  .facts dt {
    color: var(--color-text-muted);
  }

  .facts dd {
    margin: 0;
  }

  .area {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Form */

  .intake {
    grid-area: form;
    align-self: start;
    padding: var(--space-7);
    background: var(--color-surface);
    border-top: 2px solid var(--color-heading);
  }

  .note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .summary {
    margin-top: var(--space-5);
    padding: var(--space-5);
    background: var(--color-white);
    border-left: var(--border-accent) solid var(--color-error);
  }

  .summary-heading {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-strong);
    line-height: var(--leading-snug);
    letter-spacing: normal;
    color: var(--color-text);
  }

  .summary ul {
    margin-top: var(--space-3);
  }

  /* The list items are written by the script, so they need :global. */
  .summary :global(li + li) {
    margin-top: var(--space-2);
  }

  .summary :global(a) {
    color: var(--color-error);
  }

  .notice {
    margin-bottom: var(--space-5);
    padding: var(--space-4) var(--space-5);
    background: var(--color-white);
    border-left: var(--border-accent) solid var(--color-error);
    color: var(--color-text);
  }

  .spam-check {
    margin-top: var(--space-6);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
    margin-top: var(--space-6);
  }

  .field {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-width: 0;
  }

  .wide {
    grid-column: 1 / -1;
  }

  label,
  legend {
    color: var(--color-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
  }

  .optional {
    color: var(--color-text-muted);
    font-weight: var(--weight-regular);
  }

  .hint {
    margin-top: calc(-1 * var(--space-1));
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .control {
    width: 100%;
    min-height: var(--space-7);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    line-height: var(--leading-snug);
  }

  textarea.control {
    resize: vertical;
    line-height: var(--leading-body);
  }

  .control:hover {
    border-color: var(--color-heading);
  }

  .control:focus-visible {
    outline-offset: 0;
    border-color: var(--color-focus);
  }

  .control[aria-invalid='true'] {
    border-color: var(--color-error);
    box-shadow: inset 0 0 0 1px var(--color-error);
  }

  .error {
    color: var(--color-error);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
  }

  .error[hidden] {
    display: none;
  }

  /* Project type */

  .choices {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    float: left;
    width: 100%;
    margin-bottom: var(--space-2);
    padding: 0;
  }

  .options {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .option {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--space-7);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: var(--weight-regular);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .option:hover {
    border-color: var(--color-heading);
  }

  .option:has(:checked) {
    border-color: var(--color-heading);
    background: var(--color-ocean-050);
    color: var(--color-heading);
  }

  .option:has([aria-invalid='true']) {
    border-color: var(--color-error);
  }

  .option input {
    flex-shrink: 0;
    width: var(--space-4);
    height: var(--space-4);
    margin: 0;
    accent-color: var(--color-heading);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-7);
  }

  .privacy {
    flex: 1 1 var(--width-note);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Follow-up questions */

  .follow-ups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-border);
  }

  .follow-ups .option {
    flex-grow: 0;
  }

  select.control {
    cursor: pointer;
  }

  /*
   * Reveal: with :has(), the questions stay hidden until a project type is
   * chosen, then show for that type. Each project type with questions of
   * its own needs a line in the second rule. Without :has() every question
   * shows and the server ignores answers for other types.
   */
