---
// Every photograph on the site goes through this component, so each one is
// served as AVIF and WebP at the right size, with width and height set to
// prevent layout shift.
//
//   src       An image imported from src/assets or a content image field.
//   alt       What the photograph shows, written for someone who cannot
//             see it. Required; pass "" only for a purely decorative image.
//   widths    The widths to generate, for example [480, 800, 1200].
//   sizes     How wide the image is shown, for example
//             "(max-width: 800px) 100vw, 50vw". Required so phones download
//             a small file.
//   caption   Shown under the photograph. Left out when empty, and then no
//             <figure> wrapper is rendered.
//   ratio     Crops to a shape, for example "3 / 2" or "4 / 5". Left out,
//             the photograph keeps its own shape.
//   eager     Load straight away. Use only for the first large image on a
//             page; everything else loads lazily.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  caption?: string | null;
  ratio?: string;
  eager?: boolean;
}

const { src, alt, widths, sizes, caption, ratio, eager = false } = Astro.props;
const hasCaption = Boolean(caption?.trim());
const style = ratio ? `--photo-ratio: ${ratio}` : undefined;
---

{hasCaption ? (
  <figure class="photo" style={style}>
    <Picture
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      class:list={['photo-img', { cropped: ratio }]}
    />
    <figcaption>{caption}</figcaption>
  </figure>
) : (
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    pictureAttributes={{ class: 'photo', style }}
    class:list={['photo-img', { cropped: ratio }]}
  />
)}

<style>
  .photo {
    display: block;
    margin: 0;
  }

  .photo-img {
    width: 100%;
    background: var(--color-surface);
  }

  .cropped {
    aspect-ratio: var(--photo-ratio);
    object-fit: cover;
  }

  figcaption {
    max-width: var(--width-prose);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }
</style>
