---
// One page per published project at /portfolio/<file name>/. The layout is
// in src/components/project/ProjectArticle.astro; this file finds the
// projects, their neighbors in portfolio order and the share image.
import { getImage } from 'astro:assets';
import ProjectArticle from '../../components/project/ProjectArticle.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, renderProjectStory, type Project } from '../../lib/content';
import { neighbors } from '../../lib/project-page';
import { site } from '../../lib/site';
import { projectCrumbs, projectJsonLd } from '../../lib/structured-data';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { project: project.id },
    props: { project, ...neighbors(projects, project.id) },
  }));
}

interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}

const { project, previous, next } = Astro.props;
const { title, summary, seoDescription, cover, coverAlt, location, completedYear } = project.data;
const Story = await renderProjectStory(project);

// Link previews show the cover, cropped to the 1200 x 630 card size.
const shareImage = await getImage({
  src: cover,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});

// The main photograph, at its own proportions, for the structured data.
const mainPhoto = await getImage({ src: cover, width: 1600, format: 'jpg' });
const path = `/portfolio/${project.id}/`;
const structuredData = [
  projectJsonLd(
    {
      name: title,
      description: seoDescription ?? summary,
      path,
      location,
      image: {
        url: mainPhoto.src,
        width: Number(mainPhoto.attributes.width),
        height: Number(mainPhoto.attributes.height),
        alt: coverAlt,
      },
      completedYear,
      // Credited on the page only when the project is marked for it.
      designPartner: project.data.interiorDesignPartner ? site.designPartner : null,
    },
    Astro.site ?? Astro.url.origin,
  ),
];
---

<BaseLayout
  title={title}
  description={seoDescription ?? summary}
  image={shareImage.src}
  breadcrumbs={projectCrumbs(title, path)}
  structuredData={structuredData}
>
  <ProjectArticle project={project} previous={previous} next={next}>
    <Story />
  </ProjectArticle>
</BaseLayout>
