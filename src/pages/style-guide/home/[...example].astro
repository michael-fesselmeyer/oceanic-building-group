---
// Style guide: the home page's sections filled with made-up content, so the
// cases the real content does not have yet can be checked.
//
//   /style-guide/home/       four featured projects (one with a long title,
//                            one with no location), three services, three
//                            stages, the design partner and three
//                            testimonials, one of them naming a project
//   /style-guide/home/one/   one featured project (the hero only) and a
//                            single testimonial
//   /style-guide/home/none/  every collection empty and no design partner:
//                            the navy hero and the contact band only
//
// Development and preview builds only, like the main style guide page.
import placeholderTall from '../../../assets/placeholders/placeholder-tall.jpg';
import ContactBand from '../../../components/home/ContactBand.astro';
import FeaturedProjects from '../../../components/home/FeaturedProjects.astro';
import HomeHero from '../../../components/home/HomeHero.astro';
import HomePartner from '../../../components/home/HomePartner.astro';
import HomeProcess from '../../../components/home/HomeProcess.astro';
import HomeServices from '../../../components/home/HomeServices.astro';
import HomeTestimonials from '../../../components/home/HomeTestimonials.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { Project } from '../../../lib/content';
import { exampleDesignPartner, exampleProject } from '../../../lib/examples';
import { splitFeatured, type HomeQuote, type HomeService, type HomeStep } from '../../../lib/home';
import { launched } from '../../../lib/site';

const lead = exampleProject('example-riverfront-residence', {
  title: 'Example Riverfront Residence',
  location: 'Jupiter',
  featured: true,
});

const four: Project[] = [
  lead,
  exampleProject('example-long-title', {
    title: 'A Riverfront Renovation With a Deliberately Long Title That Has to Wrap Twice',
    location: 'Jupiter Inlet Colony',
    category: 'renovation',
    status: 'under-construction',
    cover: placeholderTall,
    featured: true,
  }),
  exampleProject('example-beach-road-office', {
    title: 'Example Beach Road Office',
    location: '',
    category: 'commercial',
    featured: true,
  }),
  exampleProject('example-inlet-cottage', {
    title: 'Example Inlet Cottage',
    location: 'Tequesta',
    featured: true,
  }),
];

const services: HomeService[] = [
  {
    title: 'Example Homes',
    summary: 'A made-up service line, used on the style guide to show the services list.',
    href: '/services/custom-homes/',
  },
  {
    title: 'An Example Service Line With a Long Name',
    summary: 'A made-up service with a title long enough to wrap onto a second line.',
    href: '/services/renovations/',
  },
  {
    title: 'Example Buildings',
    summary: 'A made-up service line, used on the style guide to show the services list.',
    href: '/services/commercial/',
  },
];

const steps: HomeStep[] = [
  { title: 'Example first stage' },
  { title: 'Example stage with a length', duration: '2 to 3 weeks' },
  { title: 'Example last stage' },
];

const quotes: HomeQuote[] = [
  {
    quote: 'A made-up testimonial, set large, to show how the first quote reads on the page.',
    attribution: 'Homeowner, Example Beach',
    source: 'Example Riverfront Residence',
  },
  {
    quote: 'A second made-up testimonial, shown smaller beside the third.',
    attribution: 'Homeowner, Tequesta',
  },
  {
    quote: 'A third made-up testimonial, which is the last one the home page shows.',
    attribution: 'Business owner, Jupiter',
  },
];

const full = { services, steps, partner: exampleDesignPartner };

export function getStaticPaths() {
  if (launched) return [];
  return [
    { params: { example: undefined }, props: { name: 'every section filled', count: 4 } },
    { params: { example: 'one' }, props: { name: 'one featured project', count: 1 } },
    { params: { example: 'none' }, props: { name: 'nothing to show', count: 0 } },
  ];
}

const { name, count } = Astro.props;
const { lead: heroProject, rest } = splitFeatured(four.slice(0, count));
const filled = count > 0;
---

<BaseLayout
  title={`Style guide: home page, ${name}`}
  description="The home page's sections filled with made-up content, for checking changes during development."
  noindex
  overHero
>
  <HomeHero project={heroProject} />
  <FeaturedProjects projects={rest} />
  <HomeServices services={filled ? full.services : []} />
  <HomeProcess steps={filled ? full.steps : []} />
  <HomePartner
    partner={filled ? full.partner : null}
    summary="A made-up interior designer, used on the style guide to show the partner section."
    basedIn="Example City"
  />
  <HomeTestimonials quotes={quotes.slice(0, count === 1 ? 1 : count > 0 ? 3 : 0)} />
  <ContactBand />
</BaseLayout>
