---
// Home page, top to bottom: the hero, the featured projects, the services,
// the short version of the process, the interior design partner, client
// testimonials and the closing contact band. Each section renders nothing
// when its content is empty; the hero and the contact band always render.
// The first featured project's cover is the hero photograph.
import ContactBand from '../components/home/ContactBand.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomePartner from '../components/home/HomePartner.astro';
import HomeProcess from '../components/home/HomeProcess.astro';
import HomeServices from '../components/home/HomeServices.astro';
import HomeTestimonials from '../components/home/HomeTestimonials.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getDesignPartnerProfile,
  getFeaturedProjects,
  getProcessSteps,
  getProjects,
  getServices,
  getTestimonials,
  testimonialQuote,
} from '../lib/content';
import { homeHeroSources, preloadsFor } from '../lib/hero-photo';
import { splitFeatured, type HomeQuote } from '../lib/home';
import { servicePath } from '../lib/services';
import { site } from '../lib/site';

const { lead, rest } = splitFeatured(await getFeaturedProjects());
// The hero photograph opens the page, so its AVIF sources are preloaded ahead of the fonts.
const preloadImages = lead ? preloadsFor(await homeHeroSources(lead.data.cover)) : [];

const services = (await getServices()).map((service) => ({
  title: service.data.title,
  summary: service.data.summary,
  href: servicePath(service.id),
}));

const steps = (await getProcessSteps()).map((step) => ({
  title: step.data.title,
  duration: step.data.duration,
}));

const partnerProfile = await getDesignPartnerProfile();

// A quote names its project only when that project is published.
const projectTitles = new Map((await getProjects()).map((p) => [p.id, p.data.title]));
const quotes: HomeQuote[] = (await getTestimonials()).map((item) => ({
  quote: testimonialQuote(item),
  attribution: item.data.attribution,
  source: item.data.project ? projectTitles.get(item.data.project.id) : undefined,
}));
---

<BaseLayout
  overHero
  preloadImages={preloadImages}
  description="Custom homes, renovations and commercial construction in Jupiter and the Palm Beaches, built by a team with more than 30 years of experience."
>
  <HomeHero project={lead} />
  <FeaturedProjects projects={rest} />
  <HomeServices services={services} />
  <HomeProcess steps={steps} />
  <HomePartner
    partner={site.designPartner}
    summary={partnerProfile?.data.summary}
    basedIn={partnerProfile?.data.basedIn}
  />
  <HomeTestimonials quotes={quotes} />
  <ContactBand />
</BaseLayout>
