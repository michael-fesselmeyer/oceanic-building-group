---
// Home page. The first featured project's cover is the hero photograph and
// the other featured projects follow under "Selected work". With nothing
// featured the hero is a navy band and the featured section is left out.
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import HomeHero from '../components/home/HomeHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedProjects } from '../lib/content';
import { splitFeatured } from '../lib/home';

const { lead, rest } = splitFeatured(await getFeaturedProjects());
---

<BaseLayout
  overHero
  description="Custom homes, renovations and commercial construction in Jupiter and the Palm Beaches, built by a team with more than 30 years of experience."
>
  <HomeHero project={lead} />
  <FeaturedProjects projects={rest} />
  {/* The services, process, design partner and contact sections are added below this line. */}
</BaseLayout>
