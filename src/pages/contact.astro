---
// Contact page. The body is shared with the intake endpoint, which shows the
// same form again, filled in, when an enquiry needs another try.
import ContactPage from '../components/contact/ContactPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="Contact"
  description={`Tell ${site.name} about your custom home, renovation or commercial project, or visit the office in ${site.address.city}.`}
>
  <ContactPage />
</BaseLayout>
