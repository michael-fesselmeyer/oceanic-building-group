# Names only. Never commit a value.
#
# Build-time variables (PUBLIC_*) are read by `astro build` and `astro dev` from the shell or a
# git-ignored .env file. Server variables are read by the intake endpoint at run time: locally from
# a git-ignored .dev.vars file, in production from the Worker's encrypted settings in the
# Cloudflare dashboard. See docs/architecture.md#intake-form.

# Build-time switch. "true" removes the noindex tag and hides draft content.
PUBLIC_SITE_LAUNCHED=

# Build-time, public. Cloudflare Web Analytics token; the beacon is added only when this is set
# and PUBLIC_SITE_LAUNCHED is "true". See docs/adr/0003-cookieless-analytics.md.
PUBLIC_CF_ANALYTICS_TOKEN=

# Turnstile widget key (build time). Unset before launch uses Cloudflare's always-pass test key;
# a launched build without it renders no widget.
PUBLIC_TURNSTILE_SITE_KEY=

# Intake form (server)
# "resend" sends email; "log" only logs a redacted line. Defaults to "log" on the dev server and
# to "resend" in a built site.
EMAIL_TRANSPORT=
RESEND_API_KEY=
# The sender, on the domain verified with Resend, for example: Website <website@example.test>
LEAD_FROM_EMAIL=
# The office inbox. Several addresses may be separated by commas.
LEAD_NOTIFICATION_EMAIL=
# Unset on the dev server uses Cloudflare's always-pass test secret.
TURNSTILE_SECRET_KEY=
# "true" refuses posts without a spam-check token (visitors without JavaScript get the form back).
TURNSTILE_REQUIRED=

# SMS notification channel. Off unless exactly "true"; it costs money, so it needs the owner's
# approval. When off, none of the variables below is read. See docs/architecture.md#sms.
SMS_ENABLED=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numbers in international form, for example +15615550100. Several recipients may be separated
# by commas.
TWILIO_FROM_NUMBER=
LEAD_NOTIFICATION_PHONE=
